--- !u!114 &1798677771
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1798677769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a430b7de78259db4284bf0d2cd33836f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  subtitleText: {fileID: 433205068}
  continueIcon: {fileID: 66578958}
  spaceIndicator: {fileID: 1916818564}
  typingAudioSource: {fileID: 1863616644}
  typingClip: {fileID: 8300000, guid: 34f842b7c90c6954ba0fe826d1180403, type: 3}
  glitchAudioSource: {fileID: 69326972}
  contentGroup: {fileID: 1615483068}
  dialogueBox: {fileID: 1862274044}
  dialogueAnimator: {fileID: 1898803778}
  blinkSpeed: 0.5
  lines:
  - text: '"..."

'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<color=#FF4444>You''re close.</color>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<color=#FF4444>So close.</color>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\u2014<color=#FF4444>silence</color>\u2014"
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<i><color=#FF4444>He tried to warn you, you know.</color></i>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<i>Back at the beginning. Before the signal cut.</i>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\"<i><color=#FF4444>Don't trust the\u2014</color></i>\""
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<color=#FF4444>...Yes. That was meant to be about me.</color>"'
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: 49ceba1c8b9fd68499b3880248b64821, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\u2014<color=#888888>kzzzt</color>\u2014"
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: 49ceba1c8b9fd68499b3880248b64821, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<color=#FF4444>I''ve been here longer than he has. Longer than anything
      in this place.</color>"'
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: 49ceba1c8b9fd68499b3880248b64821, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<color=#FF4444>I am what the world became.</color> <i><color=#FF4444>What
      the virus became.</color></i>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<color=#FF4444>And I''ve been wearing his voice for quite some time now.</color>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\u2014<color=#888888>BZZZZT</color>\u2014"
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: 49ceba1c8b9fd68499b3880248b64821, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<i>He was kind. Patient. He really did want to save you.</i>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<color=#FF4444>I kept that part. It made you trust me.</color>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\u2014<color=#FF4444>silence</color>\u2014"
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<color=#FF4444>Now you''re exactly where I need you to be.</color>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<b><color=#FF4444>Come inside.</color></b>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: <color=#FF4444>---SIGNAL CLEAR---</color>
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
