--- !u!114 &1798677771
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1798677769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a430b7de78259db4284bf0d2cd33836f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  subtitleText: {fileID: 433205068}
  continueIcon: {fileID: 66578958}
  spaceIndicator: {fileID: 1916818564}
  typingAudioSource: {fileID: 1863616644}
  typingClip: {fileID: 8300000, guid: 34f842b7c90c6954ba0fe826d1180403, type: 3}
  glitchAudioSource: {fileID: 69326972}
  contentGroup: {fileID: 1615483068}
  dialogueBox: {fileID: 1862274044}
  dialogueAnimator: {fileID: 1898803778}
  blinkSpeed: 0.5
  lines:
  - text: "\"H-Hello? Can you receive this? Good\u2026 your systems are online.\""
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"Listen carefully. The signal is weak."'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\"Use <color=#E4F6B1>WASD</color> to move. Hold <color=#E4F6B1>Shift</color>
      to sprint\u2014but sprinting drains your energy.\""
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects:
    - {fileID: 336446002}
    delayBeforeTyping: 0.3
  - text: '"Monitor your health and power levels at all times."'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects:
    - {fileID: 1466111523}
    delayBeforeTyping: 0.3
  - text: "\"You\u2019ll find terminals around the facility.\""
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects:
    - {fileID: 1324636928}
    - {fileID: 0}
    delayBeforeTyping: 0.3
  - text: '"Approach them and press <color=#E4F6B1>E</color> to interact. Repair
      the corrupted code inside to restore system integrity."'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects:
    - {fileID: 70857255}
    delayBeforeTyping: 0.3
  - text: '"Once enough terminals are fixed, the lockdown should weaken. After that,
      meet me at the lower sec--"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\u2014kzzzt\u2014"
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: 49ceba1c8b9fd68499b3880248b64821, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\"\u2014the lower sector thr\u2014\""
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: ---SIGNAL BUFFERING---
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: 49ceba1c8b9fd68499b3880248b64821, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\"I\u2019ll be waiting at the\u2014\""
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\u2014BZZZZT\u2014"
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: 49ceba1c8b9fd68499b3880248b64821, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\"Don\u2019t trust the\u2014\""
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: ---CONNECTION LOST---
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: d9c01f9b61818d2438258dd25a148977, type: 3}
    focusObjects: []
