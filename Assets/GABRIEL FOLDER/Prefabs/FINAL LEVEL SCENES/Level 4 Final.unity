--- !u!114 &1798677771
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1798677769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a430b7de78259db4284bf0d2cd33836f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  subtitleText: {fileID: 433205068}
  continueIcon: {fileID: 66578958}
  spaceIndicator: {fileID: 1916818564}
  typingAudioSource: {fileID: 1863616644}
  typingClip: {fileID: 8300000, guid: 34f842b7c90c6954ba0fe826d1180403, type: 3}
  glitchAudioSource: {fileID: 69326972}
  contentGroup: {fileID: 1615483068}
  dialogueBox: {fileID: 1862274044}
  dialogueAnimator: {fileID: 1898803778}
  blinkSpeed: 0.5
  lines:
  - text: '"You made it. The maze system is behind you now."'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"You''re in the laboratory complex. <i>This is where it all started.</i>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\"The exit needs full security clearance \u2014 <color=#E4F6B1>keycards</color>,
      scattered across the lab.\""
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"Some rooms are sealed. Debug the <color=#E4F6B1>terminals</color> inside
      to open them."'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"Collect all the cards. Get to the door."'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: " \u2014<color=#888888>kzzzt</color>\u2014"
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects:
    - {fileID: 70857255}
    delayBeforeTyping: 0.3
  - text: '"<i>There''s something I''ve been meaning to tell you.</i>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"<i>About this place. About why you were built.</i>"'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\u2014<color=#888888>BZZZZT</color>\u2014"
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: 49ceba1c8b9fd68499b3880248b64821, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: "\u2014<color=#888888>BZZZZT</color>\u2014"
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: 49ceba1c8b9fd68499b3880248b64821, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: '"...<color=#FF4444>Later.</color> Focus for now."'
    typingSpeed: 0.05
    glitchTyping: 0
    glitchClip: {fileID: 0}
    focusObjects: []
    delayBeforeTyping: 0.3
  - text: <color=#888888>---SIGNAL FADING---</color>
    typingSpeed: 0.05
    glitchTyping: 1
    glitchClip: {fileID: 8300000, guid: d9c01f9b61818d2438258dd25a148977, type: 3}
    focusObjects: []
    delayBeforeTyping: 0.3
